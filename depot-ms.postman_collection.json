                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/customers/1",
                            "host": ["{{base_url}}"],
                            "path": ["customers", "1"]
                        }
                    }
                }
            ]
        }
    ]
}
